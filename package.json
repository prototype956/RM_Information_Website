{
  "name": "rm-resource-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js --production",
    "test": "node --test tests/api.test.js tests/roadmaps.test.js tests/taxonomy.test.js tests/taxonomy-requests.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:visual": "node tests/visual.mjs",
    "test:ui": "npm run build && node tests/run-ui.mjs",
    "test:roadmaps": "node tests/roadmaps-browser.mjs",
    "test:taxonomy": "node tests/taxonomy-browser.mjs",
    "test:requests": "node tests/requests-browser.mjs",
    "build:cloud": "node scripts/build-cloud.mjs",
    "test:cloud": "npm run build:cloud && node --test tests/cloud.test.mjs",
    "test:registration": "npm run build && node tests/registration-browser.mjs",
    "test:members": "npm run build && node tests/members-browser.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@xyflow/react": "12.11.6",
    "busboy": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "5.2.1",
    "gsap": "3.15.0",
    "lucide-react": "0.468.0",
    "multer": "2.3.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@openai/sites-vite-plugin": "0.2.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.1",
    "prettier": "3.9.6",
    "shadcn": "4.21.0",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  }
}
