{
  "name": "rm-knowledge-local",
  "main": "cloud/index.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory":"./dist/client","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*","/_migration/*"]},
  "d1_databases": [{"binding":"DB","database_name":"rm-knowledge-local","database_id":"local-only","migrations_dir":"drizzle"}],
  "r2_buckets": [{"binding":"FILES","bucket_name":"rm-files-local"}]
}
